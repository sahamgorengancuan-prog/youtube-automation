# Salin file ini menjadi .env lalu isi nilainya.
# .env TIDAK boleh di-commit ke git (sudah masuk .gitignore).

# --- Telegram MTProto (hanya untuk telegram.mode = "live") -------------------
# Ambil dari https://my.telegram.org → API development tools
TSC_API_ID=
TSC_API_HASH=

# --- Bot notifikasi ----------------------------------------------------------
# Buat bot lewat @BotFather, lalu isi token di bawah.
# chat_id diisi di config.json (bukan di sini) karena bukan rahasia.
TSC_BOT_TOKEN=

# --- Triage LLM (opsional) ---------------------------------------------------
# Tanpa key ini framework tetap jalan memakai aturan deterministik.
ANTHROPIC_API_KEY=
